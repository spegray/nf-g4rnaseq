/*
 * nf-g4rnaseq : RNA-seq differential expression + G-quadruplex / RNA:DNA
 * hybrid-G4 (PHQS) analysis. Config-driven; FASTQ / BAM / count-matrix entry.
 */

params {
    // --- input / output ---
    input            = null          // sample sheet CSV (sample, [fastq_1/fastq_2 | bam], factor columns...)
    outdir           = "results"
    step             = "auto"        // auto | fastq | bam | counts
    count_matrix     = null          // for step=counts (gene_id + sample columns)

    // --- reference / organism ---
    fasta            = null          // genome FASTA
    gff              = null          // GFF3 annotation (gtf also accepted by harmonize step)
    harmonize        = "length"      // length | map | none   (seqname reconciliation)
    seqname_map      = null          // 2-col TSV old<TAB>new (for harmonize=map)
    orgdb            = null          // Bioconductor OrgDb, e.g. org.Sc.sgd.db (enables GO/GSEA)
    kegg_organism    = null          // KEGG code, e.g. sce (enables KEGG; needs internet)
    gene_id_keytype  = "ORF"         // OrgDb keytype matching gene IDs (ORF/ENSEMBL/...)

    // --- design / contrasts ---
    design_formula   = "~ replicate + genotype * treatment"
    contrasts        = null          // contrasts CSV (id,type,factor,target,reference,within)
    reference_levels = ""            // 'genotype=WT;treatment=untreated'
    flag_genes       = null          // optional CSV gene_id,category (flag/exclude e.g. mating-type)

    // --- quantification ---
    strandedness     = "auto"        // auto | 0 | 1 | 2  (featureCounts -s)
    aligner          = "star"        // (fastq path)

    // --- analysis parameters (defaults = the validated study values) ---
    min_count        = 10
    padj             = 0.05
    g4_min_score     = 25
    g4_highconf_score= 47
    g4_promoter      = 500
    hybrid_run_len   = 3
    hybrid_loop_max  = 12
    hybrid_span_max  = 100
    hybrid_min_tracts= 2
    min_expr         = 10

    // --- module toggles ---
    skip_g4 = false; skip_hybrid = false; skip_go = false; skip_gsea = false; skip_report = false

    // --- containers (per-process biocontainers used for std tools; this image for R analysis) ---
    r_container      = "ghcr.io/OWNER/nf-g4rnaseq-r:0.1.0"   // built from containers/Dockerfile
    max_cpus = 8; max_memory = '16.GB'; max_time = '24.h'
}

profiles {
    standard   { docker.enabled = false }                       // local: tools on PATH
    docker     { docker.enabled = true;  docker.runOptions = '-u $(id -u):$(id -g)' }
    singularity{ singularity.enabled = true; singularity.autoMounts = true }
    conda      { conda.enabled = true; process.conda = "${projectDir}/containers/environment.yml" }
    test       { includeConfig 'conf/test.config' }
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

manifest {
    name            = 'nf-g4rnaseq'
    description      = 'RNA-seq DE + G-quadruplex & RNA:DNA hybrid-G4 (PHQS) analysis'
    author           = 'Spencer Gray'
    nextflowVersion  = '>=23.04.0'
    version          = '0.1.0'
}
