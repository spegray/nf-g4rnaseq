process {
    // Analysis processes emit a named directory (deseq2, g4, hybrid, g4enrich,
    // go, gsea, integrate); publishing at the outdir root makes that dir name the
    // results subfolder (results/deseq2, results/g4, ...). File-emitting processes
    // publish to a named subfolder.
    publishDir = [ path: { params.outdir }, mode: 'copy' ]

    withName: 'HARMONIZE'     { publishDir = [ path: "${params.outdir}/reference", mode: 'copy' ] }
    withName: 'FEATURECOUNTS' { publishDir = [ path: "${params.outdir}/counts",    mode: 'copy' ] }
    withName: 'REPORT'        { publishDir = [ path: "${params.outdir}/report",     mode: 'copy' ] }
    withName: 'MULTIQC'       { publishDir = [ path: "${params.outdir}/multiqc",    mode: 'copy' ] }
    withName: 'VERSIONS'      { publishDir = [ path: "${params.outdir}/pipeline_info", mode: 'copy' ] }
}
