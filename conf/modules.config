process {
    // default: publish each process's outputs under results/<process-name>/
    publishDir = [ path: { "${params.outdir}/${task.process.tokenize(':').last().toLowerCase()}" },
                   mode: 'copy', saveAs: { fn -> fn.equals('versions.yml') ? null : fn } ]

    withName: 'HARMONIZE'    { publishDir = [ path: "${params.outdir}/reference",  mode: 'copy' ] }
    withName: 'FEATURECOUNTS'{ publishDir = [ path: "${params.outdir}/counts",     mode: 'copy' ] }
    withName: 'DESEQ2'       { publishDir = [ path: "${params.outdir}/deseq2",      mode: 'copy' ] }
    withName: 'PREDICT_G4|HYBRID_G4|G4_ENRICHMENT' { publishDir = [ path: "${params.outdir}/g4", mode: 'copy' ] }
    withName: 'GO_ENRICHMENT'{ publishDir = [ path: "${params.outdir}/go",          mode: 'copy' ] }
    withName: 'GSEA'         { publishDir = [ path: "${params.outdir}/gsea",         mode: 'copy' ] }
    withName: 'INTEGRATE|REPORT' { publishDir = [ path: "${params.outdir}/report",   mode: 'copy' ] }
}
