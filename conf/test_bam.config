/*
 * BAM-entry regression profile (`-profile test_bam`): exercises the full
 * quantification path (FEATURECOUNTS + auto-strandedness + tuple-based sample
 * labeling) on the real dedup BAMs, then the analysis. Should reproduce the
 * counts-entry numbers (660/141/43 DEGs, 7614 G4s, ...). Requires the BAMs and
 * full reference at the paths below.
 *
 * `input` points at assets/samplesheet_bam_local.csv (gitignored) — a private,
 * machine-specific sheet whose `bam` column holds real local paths. Copy
 * assets/samplesheet_bam_example.csv to that name and fill in your BAM paths.
 */
params {
    step             = "bam"
    input            = "${projectDir}/assets/samplesheet_bam_local.csv"
    fasta            = "${projectDir}/../S288C_reference_genome_R64-5-1_20240529/S288C_reference_sequence_R64-5-1_20240529.fsa.gz"
    gff              = "${projectDir}/../S288C_reference_genome_R64-5-1_20240529/saccharomyces_cerevisiae_R64-5-1_20240529.gff.gz"
    contrasts        = "${projectDir}/assets/contrasts_example.csv"
    flag_genes       = "${projectDir}/assets/flag_genes_example.csv"
    reference_levels = "genotype=WT;treatment=untreated;replicate=1"
    harmonize        = "length"
    strandedness     = "auto"
    orgdb            = "org.Sc.sgd.db"
    gene_id_keytype  = "ORF"
    max_cpus         = 8
}
