/*
 * Self-contained test profile (`-profile test`): a downsampled dataset
 * (chromosome I only: 126 genes, 230 kb) bundled under assets/test_data/.
 * Runs the WHOLE pipeline end-to-end in ~1-2 min for CI and quick checks.
 * For the full-data regression against the published study, use `-profile test_full`.
 */
params {
    step             = "counts"
    count_matrix     = "${projectDir}/assets/test_data/counts_chrI.tsv"
    input            = "${projectDir}/assets/test_data/samplesheet_counts.csv"
    fasta            = "${projectDir}/assets/test_data/genome_chrI.fa.gz"
    gff              = "${projectDir}/assets/test_data/annotation_chrI.gff3.gz"
    contrasts        = "${projectDir}/assets/contrasts_example.csv"
    flag_genes       = "${projectDir}/assets/flag_genes_example.csv"
    reference_levels = "genotype=WT;treatment=untreated;replicate=1"
    harmonize        = "length"
    orgdb            = "org.Sc.sgd.db"
    gene_id_keytype  = "ORF"
    max_cpus         = 2
}
