/*
 * Test profile. NOTE: for fast CI this should point at a downsampled dataset
 * (a few chromosomes); it currently targets this project's full data so the
 * pipeline can be regression-tested against the published numbers
 * (RecQd 660 DEGs, 7614 G4s, GSEA NES, etc.). Run with: -profile test
 */
params {
    step             = "counts"
    count_matrix     = "${projectDir}/assets/test_data/counts.tsv"
    input            = "${projectDir}/assets/samplesheet_bam_example.csv"
    fasta            = "${projectDir}/../S288C_reference_genome_R64-5-1_20240529/S288C_reference_sequence_R64-5-1_20240529.fsa.gz"
    gff              = "${projectDir}/../S288C_reference_genome_R64-5-1_20240529/saccharomyces_cerevisiae_R64-5-1_20240529.gff.gz"
    contrasts        = "${projectDir}/assets/contrasts_example.csv"
    flag_genes       = "${projectDir}/assets/flag_genes_example.csv"
    reference_levels = "genotype=WT;treatment=untreated;replicate=1"
    harmonize        = "length"
    orgdb            = "org.Sc.sgd.db"
    kegg_organism    = null          // set to 'sce' to enable KEGG (needs internet)
    gene_id_keytype  = "ORF"
    max_cpus         = 4
}
