/*
 * FASTQ-entry test profile (`-profile test_fastq`): exercises the full read path
 * fastp -> STAR -> samtools -> featureCounts (tuple-labeled) -> DE on tiny chr-I
 * reads (4 samples x 4000 reads extracted from the BAMs). Self-contained.
 * NOTE: STAR's official builds are Linux; the conda macOS-arm64 build is flaky
 * (reads 0 input reads), so run this profile on Linux / in the container / CI.
 */
params {
    step             = "fastq"
    input            = "${projectDir}/assets/test_data/samplesheet_fastq.csv"
    fasta            = "${projectDir}/assets/test_data/genome_chrI.fa.gz"
    gff              = "${projectDir}/assets/test_data/annotation_chrI.gff3.gz"
    contrasts        = "${projectDir}/assets/test_data/contrasts_genotype.csv"
    design_formula   = "~ genotype"
    reference_levels = "genotype=WT"
    harmonize        = "length"
    strandedness     = "auto"
    skip_go          = true        // too few genes on chr I for meaningful GO
    max_cpus         = 2
}
